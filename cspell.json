{
  "version": "0.2",
  "language": "en",
  "ignorePaths": ["node_modules", "build", "dist", "coverage", "docs", ".yarn"],
  "words": [
    "catchable",
    "codeql",
    "jfrazx",
    "klass",
    "lcov",
    "oxc",
    "rolldown",
    "Snyk",
    "subclassing",
    "swcrc",
    "tryable",
    "tsdown",
    "uninferred",
    "unittests",
    "untrapped",
    "wrappable"
  ],
  "ignoreRegExpList": ["/from '[@a-zA-Z]'/", "/YY[YMD hms]+/"]
}
