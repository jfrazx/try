{
  "name": "@status/try",
  "version": "1.0.0",
  "description": "Automatically catch errors on object methods and accessors",
  "main": "./build/index.js",
  "source": "src/index.ts",
  "exports": "./build/index.modern.js",
  "module": "./build/index.module.js",
  "unpkg": "./build/index.umd.js",
  "scripts": {
    "prebuild": "rimraf build",
    "build": "microbundle",
    "check": "npm-check -u",
    "dev": "microbundle watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "predocs": "rimraf docs/api",
    "docs": "typedoc src/index.ts --out docs/api",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "try",
    "catch",
    "error",
    "tryable",
    "promise"
  ],
  "author": "jfrazx",
  "license": "MIT",
  "dependencies": {
    "@status/defaults": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "microbundle": "^0.15.1",
    "npm-check": "^6.0.1",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0"
  },
  "bugs": {
    "url": "https://github.com/jfrazx/try/issues"
  },
  "homepage": "https://github.com/jfrazx/try#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfrazx/try.git"
  }
}
