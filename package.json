{
  "name": "@status/try",
  "version": "0.0.0-development",
  "description": "Automatically catch errors on object methods and accessors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "npm run build",
    "check": "npm-check -u",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "docs": "typedoc src/index.ts --out docs/api --treatWarningsAsErrors",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "try",
    "catch",
    "error",
    "tryable",
    "promise"
  ],
  "author": "jfrazx",
  "license": "MIT",
  "dependencies": {
    "@status/defaults": "^1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "npm-check": "^6.0.1",
    "prettier": "^3.9.7",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "bugs": {
    "url": "https://github.com/jfrazx/try/issues"
  },
  "homepage": "https://github.com/jfrazx/try#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrazx/try.git"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/npm"
    ]
  }
}
